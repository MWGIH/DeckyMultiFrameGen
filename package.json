{
  "name": "decky-multi-framegen",
  "version": "0.7.3",
  "description": "Install and pick OptiScaler, HelixSR or MAKO frame generation per game from one Decky plugin.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "rollup -c && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MWGIH/DeckyMultiFrameGen.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "framegen",
    "optiscaler",
    "helixsr",
    "mako"
  ],
  "author": "MWGIH",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
